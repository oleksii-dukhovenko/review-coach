# install.sh writes .env from this file. Edit .env, then run install.sh again.

# Required. Lets the coach read your PRs and post what you approve.
# install.sh fills it from `gh auth token` every time it runs.
GH_TOKEN=

# Required. Run `claude setup-token` and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. One line about you, so explanations fit your level.
# Example: Sam, a backend developer, newer to Flutter and Dart.
REVIEW_COACH_ABOUT_ME=

# Optional. Claude model for walkthroughs; empty uses the Claude Code default.
REVIEW_COACH_MODEL=

# Optional. Port on this computer; the page is http://127.0.0.1:4477.
REVIEW_COACH_PORT=4477
